{
  "meta": {
    "version": 1,
    "description": "Cross-platform PostHog event contract for the WXYC listener apps. Both apps report into PostHog project 134292 with shared event names; platform is carried by $lib, so compatibility lives in the properties. See WXYC-Android/docs/adr/0001-shared-posthog-project.md.",
    "posthogProject": "134292",
    "platformAxis": "$lib",
    "platforms": { "ios": "posthog-ios", "android": "posthog-android" }
  },
  "vocabulary": {
    "duration": {
      "type": "number",
      "unit": "seconds",
      "notes": "Seconds, on `pause` only. Never on `play` -- iOS's PlaybackStartedEvent carries only reason/source/session_id. Not type-enforced on either platform; the real backstop is the PostHog `max(pause.duration)` guard alert (insight 95Ns1Slm). Any duration math must exclude the millisecond-era Android rows with `NOT ($lib = 'posthog-android' AND toFloat64OrNull(toString(properties.$app_build)) <= 38)` -- the cast is required, since '100' <= '38' is true as strings."
    },
    "session_id": {
      "type": "string",
      "notes": "A per-listen UUID, on both `play` and `pause`. iOS preserves it across `interruption began` / `route disconnected` because those are the first half of pause-then-auto-resume there; Android mints on every play and clears on every pause, because media3 never auto-resumes from either."
    },
    "source": {
      "type": "string",
      "enum": ["app", "carPlay", "widget", "siri", "watch", "lockScreen", "remote", "auto", "unknown"],
      "platformEnum": { "android": ["app", "remote", "auto", "unknown"] },
      "notes": "Closed enum, on `play` and `pause` only. `enum` is iOS's canonical list (PlaybackSource.swift); `platformEnum.android` must remain a subset of it -- a value iOS does not define splits the shared breakdown in two. Other events (`artwork_cache_cleared`, `concert_detail_viewed`, `request_line_feature_flag_evaluated_event`, ...) also carry a property spelled `source`; those are per-event vocabularies on iOS-only events and are declared on the event, not here."
    },
    "reason": {
      "type": "string",
      "notes": "Free text; Android may extend it, and reuses iOS's exact wording where the same thing happens on both (`interruption began`, `route disconnected`). Those two strings select DIFFERENT POPULATIONS: iOS includes transient interruptions that auto-resume, Android sees only permanent focus loss and headphone unplug, so Android reports fewer pauses and longer durations for identical listener behaviour. Filter `source != 'auto'` to compare like for like."
    }
  },
  "events": [
