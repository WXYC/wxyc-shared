{
  "meta": {
    "description": "Call number parity corpus. Every composer (library-metadata-lookup LibraryItem.call_number, Backend-Service computeCallNumber, dj-site libraryCode.ts) drives its tests from these rows so the three cannot drift apart by hand. Canonical JSON: src/test-utils/call-number-cases.json; non-TS consumers vendor it from the published tarball and pin its SHA-256.",
    "version": 1,
    "schema": {
      "id": "Unique kebab-case identifier for the row.",
      "why": "One line: what the row pins.",
      "genre": "Genre name, or null.",
      "format": "Format word (cd, CD, LP, ...), verbatim, or null.",
      "call_letters": "Artist code letters as stored, verbatim (V/A, Z-M, ST, ...), or null.",
      "artist_number": "Artist number, or null.",
      "release_number": "Release number, or null.",
      "volume_letters": "Per-release volume letters, or null. No composer renders them yet (LML#1373, Backend-Service#2827); seeded null.",
      "comp_letter": "Compilation bin letter as a first-class input, or null. No composer reads it yet (LML#1431, Backend-Service#2837, dj-site#1791); seeded null, so bins still come from call_letters or artist_name.",
      "artist_name": "Artist name as stored, or null. Kept only so a row can pin that the name is ignored once name-reading is deleted.",
      "full": "The LML/Backend string: <Genre> <Format> <artist half><release half>. Empty only when the row has nothing to compose.",
      "artist_half": "What dj-site formatArtistCodeWithPunctuation returns (trailing punctuation included), or null when the row has no artist half dj-site would render.",
      "release_half": "What dj-site formatReleaseCode returns, or null when the row has no release number.",
      "pending": "Optional object keyed by consumer (lml, backend, djsite) whose value is the ticket ref that will close that consumer's known divergence from this row; that consumer skips or expects-fail the row until then."
    },
    "decisions": [
      {
        "decision": "Partial rows render LML#1432's form: letters with no artist number is \"Rock cd ST/3\", no artist half is \"Rock cd 3\".",
        "rationale": "Decided 2026-10-05. Backend-Service#2827 aligns computeCallNumber; until then the two rows carry pending.backend. Backend's rows always have an artist number today (library_artist_view INNER JOINs genre_artist_crossreference and artist_genre_code is NOT NULL), so its side is latent."
      },
      {
        "decision": "Letter case is undecided: LML and Backend render call_letters verbatim, dj-site upper-cases it.",
        "rationale": "No source produces lowercase call letters today, so the corpus seeds uppercase rows and records the one lowercase-input row with pending.djsite pointing at this ticket instead of choosing a rule."
      }
    ]
  },
